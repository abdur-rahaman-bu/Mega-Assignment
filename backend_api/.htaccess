<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /api/

    # Allow direct access to existing files/folders
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Map endpoints
    RewriteRule ^login$ login.php [L,QSA]
    RewriteRule ^register$ register.php [L,QSA]
    RewriteRule ^logout$ logout.php [L,QSA]
    RewriteRule ^user$ user.php [L,QSA]
    RewriteRule ^categories$ categories.php [L,QSA]
    RewriteRule ^banners$ banners.php [L,QSA]
    RewriteRule ^menu-items/([0-9]+)$ menu_items.php?id=$1 [L,QSA]
    RewriteRule ^menu-items$ menu_items.php [L,QSA]
    RewriteRule ^products/([0-9]+)$ menu_items.php?id=$1 [L,QSA]
    RewriteRule ^products$ menu_items.php [L,QSA]
    RewriteRule ^favorites/([0-9]+)$ favorites.php?menu_item_id=$1 [L,QSA]
    RewriteRule ^favorites$ favorites.php [L,QSA]
    RewriteRule ^wishlist/([0-9]+)$ favorites.php?menu_item_id=$1 [L,QSA]
    RewriteRule ^wishlist$ favorites.php [L,QSA]
    RewriteRule ^cart/([0-9]+)$ cart.php?id=$1 [L,QSA]
    RewriteRule ^cart$ cart.php [L,QSA]
    RewriteRule ^addresses/([0-9]+)$ addresses.php?id=$1 [L,QSA]
    RewriteRule ^addresses$ addresses.php [L,QSA]
    RewriteRule ^orders/([0-9]+)$ orders.php?id=$1 [L,QSA]
    RewriteRule ^orders$ orders.php [L,QSA]
</IfModule>
